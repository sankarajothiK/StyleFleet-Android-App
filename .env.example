# Client-Safe Configuration (Exposed to Expo mobile bundle via EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# Server-Side Configuration (For Supabase Edge Functions / Backend only — DO NOT expose to mobile client)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here
# TWO_FACTOR_API_KEY=your_2factor_in_api_key_here
# TWO_FACTOR_TEMPLATE_NAME=Login_Verification_OTP
